<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + HttpPlatformHandler: o IIS arranca a app (python app.py --server) e passa-lhe os pedidos.
  Login Windows obrigatório (sem acesso anónimo): qualquer pessoa da organização com conta no domínio.
  Ajustar processPath ao caminho da pasta da app no servidor. Ver deploy/DEPLOY.md.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Apps\budget-dashboard\.venv\Scripts\python.exe"
                  arguments="app.py --server"
                  startupTimeLimit="180"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\app.log">
      <environmentVariables>
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>
  </system.webServer>
</configuration>
